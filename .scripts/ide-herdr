#!/bin/bash
# herdr equivalent of .scripts/ide (tmux fallback layout script).
# --no-focus on the first split replaces tmux's separate `select-pane -L`.
herdr pane split --current --direction right --ratio 0.2 --no-focus
herdr pane split --current --direction down --ratio 0.3
herdr pane split --current --direction right --ratio 0.66
herdr pane split --current --direction right --ratio 0.5
