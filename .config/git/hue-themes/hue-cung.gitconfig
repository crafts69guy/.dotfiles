# Generated by scripts/build.ts. Do not edit.
# Huế Cung — Hue theme for delta (dandavison/delta).
#
# Include it from ~/.gitconfig and select it once; the mood is switched by
# re-pointing the symlink, never by editing this line:
#
#   [include]
#       path = ~/.config/git/hue-themes/hue-current.gitconfig
#   [delta]
#       features = hue
#
# syntax-theme names the bat theme of the same mood, which must already be in
# `bat cache --build` (see .scripts/sync-hue-bat.sh) — delta falls back to its
# own default silently, not loudly, when the theme is missing.

[delta "hue"]
	light = true
	# the bat .tmTheme this repo generates for the same mood
	syntax-theme = hue-cung
	minus-style = syntax "#EECBD2"
	minus-emph-style = syntax "#E6A5AC"
	minus-non-emph-style = syntax "#F0DFE5"
	minus-empty-line-marker-style = normal "#EECBD2"
	plus-style = syntax "#C8E0D8"
	plus-emph-style = syntax "#9FCBB8"
	plus-non-emph-style = syntax "#DBEAE9"
	plus-empty-line-marker-style = normal "#C8E0D8"
	zero-style = syntax
	file-style = "#00753C" bold
	file-decoration-style = "#5C7BA8" ul
	file-added-label = [+]
	file-modified-label = [M]
	file-removed-label = [-]
	file-renamed-label = [R]
	hunk-header-style = syntax bold
	hunk-header-decoration-style = "#C9DCF2" box
	hunk-header-file-style = "#0033C9"
	hunk-header-line-number-style = "#A15A00"
	line-numbers-left-style = "#5C7BA8"
	line-numbers-right-style = "#5C7BA8"
	line-numbers-minus-style = "#C20A19"
	line-numbers-plus-style = "#00753C"
	line-numbers-zero-style = "#384B63"
	whitespace-error-style = "#A15A00" "#DACDBF"
	commit-style = "#6B2FD0" bold
	commit-decoration-style = "#C9DCF2" box
	# keep blamed code syntax-highlighted over the alternating palette
	blame-code-style = syntax
	# alternating backgrounds for `delta --blame`, walking the surface ramp
	blame-palette = "#EDF3FE #F6F9FF #FFFFFF #B0DDFF"
	grep-file-style = "#00753C"
	grep-header-file-style = "#00753C" bold
	grep-header-decoration-style = "#C9DCF2" ul
	grep-line-number-style = "#384B63"
	grep-match-line-style = syntax
	grep-match-word-style = "#001F3E" "#B0DDFF"
	grep-context-line-style = "#384B63"
	merge-conflict-ours-diff-header-style = "#A15A00" bold
	merge-conflict-ours-diff-header-decoration-style = "#C9DCF2" box
	merge-conflict-theirs-diff-header-style = "#0033C9" bold
	merge-conflict-theirs-diff-header-decoration-style = "#C9DCF2" box
