# Generated by scripts/build.ts. Do not edit.
# Huế Mưa — Hue theme for delta (dandavison/delta).
#
# Include it from ~/.gitconfig and select it once; the mood is switched by
# re-pointing the symlink, never by editing this line:
#
#   [include]
#       path = ~/.config/git/hue-themes/hue-current.gitconfig
#   [delta]
#       features = hue
#
# syntax-theme names the bat theme of the same mood, which must already be in
# `bat cache --build` (see .scripts/sync-hue-bat.sh) — delta falls back to its
# own default silently, not loudly, when the theme is missing.

[delta "hue"]
	dark = true
	# the bat .tmTheme this repo generates for the same mood
	syntax-theme = hue-mua
	minus-style = syntax "#321B26"
	minus-emph-style = syntax "#5C2630"
	minus-non-emph-style = syntax "#1C1827"
	minus-empty-line-marker-style = normal "#321B26"
	plus-style = syntax "#003228"
	plus-emph-style = syntax "#005133"
	plus-non-emph-style = syntax "#002527"
	plus-empty-line-marker-style = normal "#003228"
	zero-style = syntax
	file-style = "#00CF6A" bold
	file-decoration-style = "#4E7AA6" ul
	file-added-label = [+]
	file-modified-label = [M]
	file-removed-label = [-]
	file-renamed-label = [R]
	hunk-header-style = syntax bold
	hunk-header-decoration-style = "#1B3A5C" box
	hunk-header-file-style = "#10B6F8"
	hunk-header-line-number-style = "#FF8D00"
	line-numbers-left-style = "#1B3A5C"
	line-numbers-right-style = "#1B3A5C"
	line-numbers-minus-style = "#FF5A63"
	line-numbers-plus-style = "#00CF6A"
	line-numbers-zero-style = "#9DB4D4"
	whitespace-error-style = "#FF8D00" "#403B2F"
	commit-style = "#8A7BFF" bold
	commit-decoration-style = "#1B3A5C" box
	# keep blamed code syntax-highlighted over the alternating palette
	blame-code-style = syntax
	# alternating backgrounds for `delta --blame`, walking the surface ramp
	blame-palette = "#001F3E #052748 #0A2E52 #123F6E"
	grep-file-style = "#00CF6A"
	grep-header-file-style = "#00CF6A" bold
	grep-header-decoration-style = "#1B3A5C" ul
	grep-line-number-style = "#9DB4D4"
	grep-match-line-style = syntax
	grep-match-word-style = "#E5F4FF" "#123F6E"
	grep-context-line-style = "#9DB4D4"
	merge-conflict-ours-diff-header-style = "#FF8D00" bold
	merge-conflict-ours-diff-header-decoration-style = "#1B3A5C" box
	merge-conflict-theirs-diff-header-style = "#10B6F8" bold
	merge-conflict-theirs-diff-header-decoration-style = "#1B3A5C" box
