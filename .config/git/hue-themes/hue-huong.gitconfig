# Generated by scripts/build.ts. Do not edit.
# Huế Hương — Hue theme for delta (dandavison/delta).
#
# Include it from ~/.gitconfig and select it once; the mood is switched by
# re-pointing the symlink, never by editing this line:
#
#   [include]
#       path = ~/.config/git/hue-themes/hue-current.gitconfig
#   [delta]
#       features = hue
#
# syntax-theme names the bat theme of the same mood, which must already be in
# `bat cache --build` (see .scripts/sync-hue-bat.sh) — delta falls back to its
# own default silently, not loudly, when the theme is missing.

[delta "hue"]
	dark = true
	# the bat .tmTheme this repo generates for the same mood
	syntax-theme = hue-huong
	minus-style = syntax "#2E231F"
	minus-emph-style = syntax "#4F3530"
	minus-non-emph-style = syntax "#1E1B18"
	minus-empty-line-marker-style = normal "#2E231F"
	plus-style = syntax "#1A3128"
	plus-emph-style = syntax "#2B5142"
	plus-non-emph-style = syntax "#13241E"
	plus-empty-line-marker-style = normal "#1A3128"
	zero-style = syntax
	file-style = "#6FD0A8" bold
	file-decoration-style = "#587168" ul
	file-added-label = [+]
	file-modified-label = [M]
	file-removed-label = [-]
	file-renamed-label = [R]
	hunk-header-style = syntax bold
	hunk-header-decoration-style = "#2C3F39" box
	hunk-header-file-style = "#7FBAC8"
	hunk-header-line-number-style = "#DCBB80"
	line-numbers-left-style = "#2C3F39"
	line-numbers-right-style = "#2C3F39"
	line-numbers-minus-style = "#D38478"
	line-numbers-plus-style = "#6FD0A8"
	line-numbers-zero-style = "#98A59C"
	whitespace-error-style = "#DCBB80" "#424533"
	commit-style = "#A9A0C8" bold
	commit-decoration-style = "#2C3F39" box
	# keep blamed code syntax-highlighted over the alternating palette
	blame-code-style = syntax
	# alternating backgrounds for `delta --blame`, walking the surface ramp
	blame-palette = "#0F1D19 #14241F #182A24 #244E42"
	grep-file-style = "#6FD0A8"
	grep-header-file-style = "#6FD0A8" bold
	grep-header-decoration-style = "#2C3F39" ul
	grep-line-number-style = "#98A59C"
	grep-match-line-style = syntax
	grep-match-word-style = "#D6DAD0" "#244E42"
	grep-context-line-style = "#98A59C"
	merge-conflict-ours-diff-header-style = "#DCBB80" bold
	merge-conflict-ours-diff-header-decoration-style = "#2C3F39" box
	merge-conflict-theirs-diff-header-style = "#7FBAC8" bold
	merge-conflict-theirs-diff-header-decoration-style = "#2C3F39" box
