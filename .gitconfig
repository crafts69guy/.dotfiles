[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	ignorecase = false
	pager = delta

[init]
	defaultBranch = production

[push]
	default = simple

[pull]
	rebase = true

[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto

[user]
	name = crafts69.guy
	email = crafts69.guy@gmail.com

# Work identity and GitHub SSH alias for work repos.
[includeIf "gitdir:~/Developments/bitbucket.org/"]
	path = ~/.config/git/work.gitconfig

# Personal identity and GitHub SSH alias for personal repos.
[includeIf "gitdir:~/Developments/github.com/"]
	path = ~/.config/git/personal.gitconfig

[github]
	user = crafts69

[hub]
	protocol = https

# ---------------------------------------------------------------------------
# delta — diff pager themed from the Hue token contract
#
# The colours live in the generated fragment included below, not here: it is
# written by .scripts/sync-hue-delta.sh from
# crafts69guy/hue-theme (packages/terminal-themes/delta), and hue-current is a
# symlink re-pointed by `hue-theme <mood>`. Every mood declares the same
# feature name, `hue`, so nothing in this file changes when the mood does.
#
# Keep only behaviour here. Do NOT set syntax-theme or dark/light — the
# fragment declares its own, which is how Cung comes up light instead of being
# forced dark.
# ---------------------------------------------------------------------------
[include]
	path = ~/.config/git/hue-themes/hue-current.gitconfig

[interactive]
	diffFilter = delta --color-only

[delta]
	features = hue
	navigate = true
	line-numbers = true
	hyperlinks = true
	tabs = 4

[diff]
	colorMoved = default
	tool = nvimdiff

[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[merge]
	conflictStyle = zdiff3

[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true

[commit]
	gpgSign = false
	template = ~/.stCommitMsg

[gpg]
	format = openpgp
	program = gpg

[gpg "ssh"]
	program = ssh-keygen

[tag]
	forceSignAnnotated = false
[credential "https://github.com"]
	username = crafts69.guy
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

[ghq]
	root = ~/Developments

[alias]
	a = "!git status --short | peco | awk '{print $2}' | xargs git add"
	d = diff
	co = checkout
	ci = commit
	ca = commit -a
	ps = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
	pl = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
	st = status
	br = branch
	ba = branch -a
	bm = branch --merged
	bn = branch --no-merged
	df = "!git hist | peco | awk '{print $2}' | xargs -I {} git diff {}^ {}"
	hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --graph --date=relative --decorate --all
	llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative
	open = "!hub browse"
	type = cat-file -t
	dump = cat-file -p
	find = "!f() { git log --pretty=format:\"%h %cd [%cn] %s%d\" --date=relative -S'pretty' -S\"$@\" | peco | awk '{print $1}' | xargs -I {} git diff {}^ {}; }; f"
	# edit conflicted file on merge
	edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; vim `f`"
	# add conflicted file on merge
	add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
